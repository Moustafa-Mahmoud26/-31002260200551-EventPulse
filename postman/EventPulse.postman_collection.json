{
  "info": {
    "name": "EventPulse API",
    "description": "Collection for the EventPulse Event Management Platform API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "eventId", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "registrationId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"Password123\",\n  \"role\": \"attendee\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane@example.com\",\n  \"password\": \"Password123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Get Categories",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/categories"
          }
        },
        {
          "name": "Create Category (admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/api/categories",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Music\",\n  \"description\": \"Concerts and live music events\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "Get All Events",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events?page=1&limit=10"
          }
        },
        {
          "name": "Get Events Filtered",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events?category={{categoryId}}&city=Cairo&startDate=2026-01-01&endDate=2026-12-31&search=music&sortBy=date&order=asc&page=1&limit=10"
          }
        },
        {
          "name": "Get Single Event",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events/{{eventId}}"
          }
        },
        {
          "name": "Get Event Status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events/{{eventId}}/status"
          }
        },
        {
          "name": "Create Event (admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/api/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Tech Conference 2026\",\n  \"description\": \"A gathering of developers and founders\",\n  \"category\": \"{{categoryId}}\",\n  \"date\": \"2026-10-05T09:00:00.000Z\",\n  \"city\": \"Cairo\",\n  \"venue\": \"Cairo Convention Center\",\n  \"capacity\": 300\n}"
            }
          }
        },
        {
          "name": "Update Event (admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/api/events/{{eventId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"capacity\": 350\n}"
            }
          }
        },
        {
          "name": "Delete Event (admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/events/{{eventId}}"
          }
        }
      ]
    },
    {
      "name": "Registrations",
      "item": [
        {
          "name": "Register for Event",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/registrations",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"{{eventId}}\"\n}"
            }
          }
        },
        {
          "name": "Get My Registrations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/registrations/my"
          }
        },
        {
          "name": "Cancel Registration",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/registrations/{{registrationId}}"
          }
        }
      ]
    },
    {
      "name": "Announcements",
      "item": [
        {
          "name": "Send Announcement (admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/api/announcements",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"text\": \"Session starts in 10 minutes\"\n}"
            }
          }
        },
        {
          "name": "Get Announcement History",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/announcements/{{eventId}}"
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    }
  ]
}
